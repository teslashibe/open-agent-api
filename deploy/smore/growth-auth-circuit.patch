+package draftingtool
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestChatCompletionUpstreamAuthCircuitSuppressesHTTPUntilRetry(t *testing.T) {
+	now := time.Date(2026, 7, 22, 7, 0, 0, 0, time.UTC)
+	var calls atomic.Int64
+	client := NewOpenRouterClient("gateway-bearer", "https://gateway.example.test/v1", time.Second)
+	client.http = &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+		call := calls.Add(1)
+		if call == 1 {
+			return testResponse(http.StatusServiceUnavailable, "600", `{"error":{"message":"provider secret must not leak","type":"authentication_error","code":"upstream_authentication_failed"}}`), nil
+		}
+		return testResponse(http.StatusOK, "", `{"choices":[{"message":{"content":"recovered"}}]}`), nil
+	})}
+	client.now = func() time.Time { return now }
+
+	_, err := client.ChatCompletion(context.Background(), ChatRequest{Model: "gpt-5.6-terra"})
+	var authErr *UpstreamAuthError
+	if !errors.As(err, &authErr) {
+		t.Fatalf("first ChatCompletion() error = %v, want UpstreamAuthError", err)
+	}
+	wantRetryAt := now.Add(10 * time.Minute)
+	if !authErr.RetryAt.Equal(wantRetryAt) {
+		t.Fatalf("RetryAt = %s, want %s", authErr.RetryAt, wantRetryAt)
+	}
+	if err.Error() != UpstreamAuthenticationFailedCode {
+		t.Fatalf("error = %q, want sanitized code", err)
+	}
+
+	_, err = client.ChatCompletion(context.Background(), ChatRequest{Model: "gpt-5.6-terra"})
+	if !errors.As(err, &authErr) || calls.Load() != 1 {
+		t.Fatalf("circuit retry = %v calls=%d, want local failure and one HTTP call", err, calls.Load())
+	}
+
+	now = wantRetryAt.Add(time.Second)
+	out, err := client.ChatCompletion(context.Background(), ChatRequest{Model: "gpt-5.6-terra"})
+	if err != nil || out != "recovered" || calls.Load() != 2 {
+		t.Fatalf("recovery = %q, %v calls=%d", out, err, calls.Load())
+	}
+	if _, open := client.AuthCircuitOpen(); open {
+		t.Fatal("auth circuit remained open after successful recovery request")
+	}
+}
+
+func TestChatCompletionDoesNotOpenCircuitForGatewayBearerFailure(t *testing.T) {
+	var calls atomic.Int64
+	client := NewOpenRouterClient("wrong-gateway-bearer", "https://gateway.example.test/v1", time.Second)
+	client.http = &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+		calls.Add(1)
+		return testResponse(http.StatusUnauthorized, "", `{"error":{"code":"invalid_gateway_credentials"}}`), nil
+	})}
+	for range 2 {
+		if _, err := client.ChatCompletion(context.Background(), ChatRequest{}); err == nil {
+			t.Fatal("ChatCompletion() error = nil")
+		}
+	}
+	if calls.Load() != 2 {
+		t.Fatalf("HTTP calls = %d, want 2 because inbound bearer failures must not open the upstream circuit", calls.Load())
+	}
+}
+
+func TestUpstreamAuthCircuitBackoffGrowsAndCaps(t *testing.T) {
+	now := time.Date(2026, 7, 22, 7, 0, 0, 0, time.UTC)
+	client := NewOpenRouterClient("gateway-bearer", "https://gateway.example.test/v1", time.Second)
+	client.now = func() time.Time { return now }
+
+	for attempt, want := range []time.Duration{5 * time.Minute, 10 * time.Minute, 20 * time.Minute, 40 * time.Minute, time.Hour, time.Hour} {
+		until := client.openAuthCircuit("")
+		if got := until.Sub(now); got != want {
+			t.Fatalf("attempt %d backoff = %s, want %s", attempt+1, got, want)
+		}
+		now = until.Add(time.Second)
+	}
+}
+
+type roundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f roundTripFunc) RoundTrip(req *http.Request) (*http.Response, error) {
+	return f(req)
+}
+
+func testResponse(status int, retryAfter, body string) *http.Response {
+	header := make(http.Header)
+	if retryAfter != "" {
+		header.Set("Retry-After", retryAfter)
+	}
+	return &http.Response{
+		StatusCode: status,
+		Header:     header,
+		Body:       io.NopCloser(strings.NewReader(body)),
+	}
+}
