+package growthleads
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+type fixedLLMAuthCircuit struct {
+	retryAt time.Time
+	open    bool
+}
+
+func (c fixedLLMAuthCircuit) AuthCircuitOpen() (time.Time, bool) {
+	return c.retryAt, c.open
+}
+
+func TestGrowthCadenceStopsBeforeClaimWhileLLMAuthCircuitOpen(t *testing.T) {
+	retryAt := time.Now().Add(5 * time.Minute)
+	w := &Worker{llmAuthCircuit: fixedLLMAuthCircuit{retryAt: retryAt, open: true}}
+	w.setArchiveListenerUp(true)
+
+	// A nil Store would panic on the first claim or maintenance operation. A
+	// clean return proves the circuit gate runs before any scheduled work.
+	w.runOnce(context.Background())
+}
+
+func TestGrowthRunNowReturnsRetryableAuthCircuitWithoutClaim(t *testing.T) {
+	retryAt := time.Now().Add(5 * time.Minute).UTC()
+	ready := make(chan struct{})
+	close(ready)
+	w := &Worker{
+		archiveListenerReady: ready,
+		llmAuthCircuit:       fixedLLMAuthCircuit{retryAt: retryAt, open: true},
+	}
+	// Mark the process-lifetime listener as already started so this unit test
+	// can exercise the pre-claim gate without constructing a database Store.
+	w.archiveListenerOnce.Do(func() {})
+
+	_, err := w.RunNow(context.Background(), "watch", "user")
+	var runErr *RunNowError
+	if !errors.As(err, &runErr) {
+		t.Fatalf("RunNow() error = %v, want RunNowError", err)
+	}
+	if runErr.Code != upstreamAuthenticationFailedCode || !runErr.Retryable || runErr.RetryAt == nil || !runErr.RetryAt.Equal(retryAt) {
+		t.Fatalf("RunNow() error = %#v", runErr)
+	}
+}
