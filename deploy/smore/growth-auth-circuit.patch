+// AuthCircuitOpen reports the shared LLM authentication backoff. Growth and
+// Outbox workers use it to avoid claiming LLM-dependent work while the client
+// itself uses the same state to suppress direct HTTP retries.
+func (c *OpenRouterClient) AuthCircuitOpen() (time.Time, bool) {
+	if c == nil {
+		return time.Time{}, false
+	}
+	c.mu.RLock()
+	until := c.authCircuitUntil
+	now := c.now
+	c.mu.RUnlock()
+	if now == nil {
+		now = time.Now
+	}
+	return until, !until.IsZero() && now().Before(until)
+}
+
+func (c *OpenRouterClient) openAuthCircuit(retryAfter string) time.Time {
+	now := c.now
+	if now == nil {
+		now = time.Now
+	}
+	current := now()
+	c.mu.Lock()
+	backoff := defaultAuthCircuitBackoff
+	for attempt := uint(0); attempt < c.authFailures && backoff < time.Hour; attempt++ {
+		backoff *= 2
+	}
+	if backoff > time.Hour {
+		backoff = time.Hour
+	}
+	c.authFailures++
+	until := current.Add(backoff)
+	if parsed, ok := parseRetryAfter(retryAfter, current); ok && parsed.After(until) {
+		until = parsed
+	}
+	if c.authCircuitUntil.After(until) {
+		until = c.authCircuitUntil
+	} else {
+		c.authCircuitUntil = until
+	}
+	c.mu.Unlock()
+	return until
+}
+
+func (c *OpenRouterClient) closeAuthCircuit() {
+	c.mu.Lock()
+	c.authCircuitUntil = time.Time{}
+	c.authFailures = 0
+	c.mu.Unlock()
+}
+
+func gatewayErrorCode(body []byte) string {
+	var decoded struct {
+		Error struct {
+			Code string `json:"code"`
+		} `json:"error"`
+	}
+	if json.Unmarshal(body, &decoded) != nil {
+		return ""
+	}
+	return strings.TrimSpace(decoded.Error.Code)
+}
+
+func parseRetryAfter(value string, now time.Time) (time.Time, bool) {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return time.Time{}, false
+	}
+	if seconds, err := time.ParseDuration(value + "s"); err == nil && seconds >= 0 {
+		return now.Add(seconds), true
+	}
+	when, err := http.ParseTime(value)
+	return when, err == nil && when.After(now)
+}
